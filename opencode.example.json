{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dbscope": {
      "type": "local",
      "command": [
        "bash",
        "/absolute/path/to/dbscope/scripts/dbscope-mcp.sh"
      ],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      "*": "allow",
      "~/.config/dbscope/**": "deny",
      "~/.local/state/dbscope/**": "deny"
    }
  }
}
